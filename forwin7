
@echo off
title KAMAXHUB TERMINAL
color 0A
mode con: cols=75 lines=28

:MENU
cls
echo.
echo ============================================
echo          KAMAXHUB TERMINAL
echo ============================================
echo.
echo        WELCOME TO YOUR COMPUTER
echo.
echo  [1] COMPUTER INFORMATION
echo  [2] INTERNET TEST
echo  [3] SHOW FILES
echo  [4] DATE AND TIME
echo  [5] HACKER SCREEN
echo  [6] OPEN NOTEPAD
echo  [7] OPEN CALCULATOR
echo  [0] EXIT
echo.
echo ============================================
set /p choice=SELECT OPTION:

if "%choice%"=="1" goto INFO
if "%choice%"=="2" goto NET
if "%choice%"=="3" goto FILES
if "%choice%"=="4" goto CLOCK
if "%choice%"=="5" goto HACKER
if "%choice%"=="6" start notepad & goto MENU
if "%choice%"=="7" start calc & goto MENU
if "%choice%"=="0" exit
goto MENU

:INFO
cls
systeminfo
pause
goto MENU

:NET
cls
ping google.com
pause
goto MENU

:FILES
cls
dir C:\
pause
goto MENU

:CLOCK
cls
echo DATE:
date /t
echo TIME:
time /t
pause
goto MENU

:HACKER
cls
color 0A
echo KAMAXHUB HACKER SCREEN
echo.
:LOOP
echo %random% %random% %random% %random% %random%
goto LOOP
